#!/system/bin/sh
# Sshd4a extented - app control CLI.
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Commands: help, version, env, start, stop, status, shell. Planned: --get-settings / --set-settings
# (needs a settings bridge into the app, not implemented yet).

BASE=/data/local/tmp/Sshd4a
VERSION_FILE=$BASE/etc/app-version
PKG=com.roshkond.sshd4a.extended
ACTIVITY=$PKG/com.hardbacknutter.sshd.QuickStartActivity

cmd_version() {
    if [ -e "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown (no $VERSION_FILE - re-run provisioning: save Settings or restart the service)"
    fi
}

# start/stop need the app's "Allow starting the service by an external Intent" option.
# `am` only works for adb shell and root; an ordinary app uid cannot use it, so fall back
# to su when there is one.
cmd_control() {
    act="com.hardbacknutter.sshd.fg.$1"
    out=$(am start -n "$ACTIVITY" -a "$act" 2>&1); rc=$?
    case "$out" in *Exception*|*Error*|*Denial*) rc=1 ;; esac
    if [ "$rc" -ne 0 ] && command -v su >/dev/null 2>&1; then
        echo "'am' is not usable as uid $(id -u); retrying through su (a root prompt may appear)..."
        out=$(su -c "am start -n '$ACTIVITY' -a '$act'" 2>&1); rc=$?
        case "$out" in *Exception*|*Error*|*Denial*) rc=1 ;; esac
    fi
    if [ "$rc" -ne 0 ]; then
        echo "Could not send the request:"
        echo "$out" | head -3
        echo "Without root an ordinary app cannot send it: use adb shell, su, or another app"
        echo "(Tasker, MacroDroid, ...) that can send the intent."
        return 1
    fi
    echo "Request sent: $1  (outcome: logcat -d -s ExternalControl)"
}

cmd_status() {
    port=
    [ -r "$BASE/etc/sshd-port" ] && port=$(cat "$BASE/etc/sshd-port")
    if [ -z "$port" ]; then
        echo "unknown: no $BASE/etc/sshd-port (save Settings or restart the service once)"
        return 1
    fi
    if [ -r /proc/net/tcp ]; then
        hex=$(printf '%04X' "$port")
        if grep -qiE "^ *[0-9]+: [0-9A-F]+:$hex [0-9A-F]+:[0-9A-F]+ 0A" /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
            echo "running: listening on port $port"
            return 0
        fi
        echo "not running: nothing is listening on port $port"
        return 3
    fi
    # Apps cannot read /proc/net/tcp: ask the server itself - an SSH server answers
    # with its "SSH-..." banner as soon as a client connects.
    if command -v nc >/dev/null 2>&1; then
        banner=$(echo | nc -w 2 127.0.0.1 "$port" 2>/dev/null | head -c 8)
        case "$banner" in
            SSH-*) echo "running: SSH server answers on port $port"; return 0 ;;
            *)     echo "not running: no SSH server answers on port $port"; return 3 ;;
        esac
    fi
    echo "unknown: /proc/net/tcp is not readable and there is no 'nc' to probe port $port"
    return 1
}

# Start an interactive shell with the app's environment (PATH, tmux alias, prompt, ...)
# picked by the caller's uid: root -> rc-root, shell -> rc-shell, anything else -> rc-user.
cmd_shell() {
    uid=$(id -u)
    case "$uid" in
        0)    rc=rc-root ;;
        2000) rc=rc-shell ;;
        *)    rc=rc-user ;;
    esac
    if [ ! -r "$BASE/etc/$rc" ]; then
        echo "Cannot read $BASE/etc/$rc from this shell (uid $uid)."
        echo "Start the Sshd4a service once so the profiles exist, or try as another user (su)."
        return 1
    fi
    echo "Sshd4a environment ($rc) - 'exit' returns to the previous shell."
    SSHD4A_SHELL_UPGRADED= ENV="$BASE/etc/$rc" exec sh -i
}

cmd_env() {
    case "$1" in
        --file) echo "$BASE/etc/env" ;;
        *)
            # eval-able output, e.g.:  eval "$(sshd4a env)"
            echo "SSHD4A_BASE='$BASE'; export SSHD4A_BASE"
            echo "case \":\$PATH:\" in *':$BASE/bin:'*) ;; *) PATH=\"\$PATH:$BASE/bin\"; export PATH ;; esac"
            ;;
    esac
}

cmd_help() {
    printf 'Sshd4a extented  '
    cmd_version
    if [ -r "$BASE/etc/help.txt" ]; then
        cat "$BASE/etc/help.txt"
    else
        echo "(help text missing - re-run provisioning: save Settings or restart the service)"
    fi
}

case "$1" in
    -v|--version|version|ver)
        cmd_version
        ;;
    env)
        shift
        cmd_env "$@"
        ;;
    start) cmd_control START ;;
    stop)  cmd_control STOP ;;
    status) cmd_status ;;
    shell)  cmd_shell ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "Sshd4a extented CLI"
        printf 'Version: '
        cmd_version
        echo "Usage: sshd4a [help|-v|--version|start|stop|status|shell|env [--file]]"
        echo "Run 'help' for the full reference."
        ;;
esac
