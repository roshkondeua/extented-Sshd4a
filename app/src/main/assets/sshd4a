#!/system/bin/sh
# Sshd4a extented - app control CLI.
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Commands: help, version, env, start, stop, status, shell, survival. Planned: --get-settings / --set-settings
# (needs a settings bridge into the app, not implemented yet).

BASE=/data/local/tmp/Sshd4a
VERSION_FILE=$BASE/etc/app-version
PKG=com.roshkond.sshd4a.extended
ACTIVITY=$PKG/com.hardbacknutter.sshd.QuickStartActivity

cmd_version() {
    if [ -e "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown (no $VERSION_FILE - re-run provisioning: save Settings or restart the service)"
    fi
}

# start/stop need the app's "Allow starting the service by an external Intent" option.
# `am` only works for adb shell and root; an ordinary app uid cannot use it, so fall back
# to su when there is one.
cmd_control() {
    act="com.hardbacknutter.sshd.fg.$1"
    out=$(am start -n "$ACTIVITY" -a "$act" 2>&1); rc=$?
    case "$out" in *Exception*|*Error*|*Denial*) rc=1 ;; esac
    if [ "$rc" -ne 0 ] && command -v su >/dev/null 2>&1; then
        echo "'am' is not usable as uid $(id -u); retrying through su (a root prompt may appear)..."
        out=$(su -c "am start -n '$ACTIVITY' -a '$act'" 2>&1); rc=$?
        case "$out" in *Exception*|*Error*|*Denial*) rc=1 ;; esac
    fi
    if [ "$rc" -ne 0 ]; then
        echo "Could not send the request:"
        echo "$out" | head -3
        echo "Without root an ordinary app cannot send it: use adb shell, su, or another app"
        echo "(Tasker, MacroDroid, ...) that can send the intent."
        return 1
    fi
    echo "Request sent: $1  (outcome: logcat -d -s ExternalControl)"
}

cmd_status() {
    port=
    [ -r "$BASE/etc/sshd-port" ] && port=$(cat "$BASE/etc/sshd-port")
    if [ -z "$port" ]; then
        echo "unknown: no $BASE/etc/sshd-port (save Settings or restart the service once)"
        return 1
    fi
    if [ -r /proc/net/tcp ]; then
        hex=$(printf '%04X' "$port")
        if grep -qiE "^ *[0-9]+: [0-9A-F]+:$hex [0-9A-F]+:[0-9A-F]+ 0A" /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
            echo "running: listening on port $port"
            return 0
        fi
        echo "not running: nothing is listening on port $port"
        return 3
    fi
    # Apps cannot read /proc/net/tcp: ask the server itself - an SSH server answers
    # with its "SSH-..." banner as soon as a client connects.
    if command -v nc >/dev/null 2>&1; then
        banner=$(echo | nc -w 2 127.0.0.1 "$port" 2>/dev/null | head -c 8)
        case "$banner" in
            SSH-*) echo "running: SSH server answers on port $port"; return 0 ;;
            *)     echo "not running: no SSH server answers on port $port"; return 3 ;;
        esac
    fi
    echo "unknown: /proc/net/tcp is not readable and there is no 'nc' to probe port $port"
    return 1
}

# Start an interactive shell with the app's environment (PATH, tmux alias, prompt, ...)
# picked by the caller's uid: root -> rc-root, shell -> rc-shell, anything else -> rc-user.
cmd_shell() {
    uid=$(id -u)
    case "$uid" in
        0)    rc=rc-root ;;
        2000) rc=rc-shell ;;
        *)    rc=rc-user ;;
    esac
    if [ ! -r "$BASE/etc/$rc" ]; then
        echo "Cannot read $BASE/etc/$rc from this shell (uid $uid)."
        echo "Start the Sshd4a service once so the profiles exist, or try as another user (su)."
        return 1
    fi
    echo "Sshd4a environment ($rc) - 'exit' returns to the previous shell."
    SSHD4A_SHELL_UPGRADED= ENV="$BASE/etc/$rc" exec sh -i
}

# Process-survival diagnostics and (reversible) workarounds. Needs adb shell (uid shell) or root.
#   sshd4a survival            status: device, kill-related settings, last exit reasons
#   sshd4a survival apply      apply the workarounds
#   sshd4a survival revert     undo them
cmd_survival() {
    sub=${1:-status}
    uid=$(id -u)
    sdk=$(getprop ro.build.version.sdk)
    rel=$(getprop ro.build.version.release)
    model=$(getprop ro.product.model)
    miui=$(getprop ro.miui.ui.version.name)
    echo "Device: $model, Android $rel (SDK $sdk)${miui:+, MIUI $miui}"
    case "$uid" in
        0|2000) ;;
        *) echo "Needs adb shell (shell) or root; this is uid $uid. Run it via adb shell or 'su'."; return 1 ;;
    esac
    case "$sub" in
        status)
            if [ "$sdk" -ge 32 ]; then
                echo "phantom-process monitor: settings_enable_monitor_phantom_procs = $(settings get global settings_enable_monitor_phantom_procs 2>&1)  (false = killer off)"
            elif [ "$sdk" -eq 31 ]; then
                echo "phantom-process limit:   max_phantom_processes = $(device_config get activity_manager max_phantom_processes 2>&1)  (default 32)"
                echo "device_config sync:      $(device_config get_sync_disabled_for_tests 2>&1)"
            else
                echo "phantom-process killer: not applicable (SDK < 31)"
            fi
            echo "battery whitelist:       $(cmd deviceidle whitelist 2>/dev/null | grep "$PKG" || echo 'NOT whitelisted')"
            echo "appop RUN_IN_BACKGROUND:     $(cmd appops get "$PKG" RUN_IN_BACKGROUND 2>&1)"
            echo "appop RUN_ANY_IN_BACKGROUND: $(cmd appops get "$PKG" RUN_ANY_IN_BACKGROUND 2>&1)"
            echo "Last exit records (newest first):"
            dumpsys activity exit-info "$PKG" 2>/dev/null | grep -E "timestamp=|reason=|importance=|description=" | head -16
            ;;
        apply)
            run() { echo "+ $*"; "$@"; }
            if [ "$sdk" -ge 32 ]; then
                run settings put global settings_enable_monitor_phantom_procs false
            elif [ "$sdk" -eq 31 ]; then
                run device_config set_sync_disabled_for_tests persistent
                run device_config put activity_manager max_phantom_processes 2147483647
            fi
            run cmd deviceidle whitelist "+$PKG"
            run cmd appops set "$PKG" RUN_IN_BACKGROUND allow
            run cmd appops set "$PKG" RUN_ANY_IN_BACKGROUND allow
            echo "Done. May cost some battery; undo with: sshd4a survival revert"
            ;;
        revert)
            run() { echo "+ $*"; "$@"; }
            if [ "$sdk" -ge 32 ]; then
                run settings put global settings_enable_monitor_phantom_procs true
            elif [ "$sdk" -eq 31 ]; then
                run device_config delete activity_manager max_phantom_processes
                run device_config set_sync_disabled_for_tests none
            fi
            run cmd deviceidle whitelist "-$PKG"
            run cmd appops set "$PKG" RUN_IN_BACKGROUND default
            run cmd appops set "$PKG" RUN_ANY_IN_BACKGROUND default
            echo "Reverted to system defaults."
            ;;
        *) echo "Usage: sshd4a survival [status|apply|revert]"; return 2 ;;
    esac
}

cmd_env() {
    case "$1" in
        --file) echo "$BASE/etc/env" ;;
        *)
            # eval-able output, e.g.:  eval "$(sshd4a env)"
            echo "SSHD4A_BASE='$BASE'; export SSHD4A_BASE"
            echo "case \":\$PATH:\" in *':$BASE/bin:'*) ;; *) PATH=\"\$PATH:$BASE/bin\"; export PATH ;; esac"
            ;;
    esac
}

cmd_help() {
    printf 'Sshd4a extented  '
    cmd_version
    if [ -r "$BASE/etc/help.txt" ]; then
        cat "$BASE/etc/help.txt"
    else
        echo "(help text missing - re-run provisioning: save Settings or restart the service)"
    fi
}

case "$1" in
    -v|--version|version|ver)
        cmd_version
        ;;
    env)
        shift
        cmd_env "$@"
        ;;
    start) cmd_control START ;;
    stop)  cmd_control STOP ;;
    status) cmd_status ;;
    shell)  cmd_shell ;;
    survival) shift; cmd_survival "$@" ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "Sshd4a extented CLI"
        printf 'Version: '
        cmd_version
        echo "Usage: sshd4a [help|-v|--version|start|stop|status|shell|survival|env [--file]]"
        echo "Run 'help' for the full reference."
        ;;
esac
