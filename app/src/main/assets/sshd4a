#!/system/bin/sh
# Sshd4a extented - app control CLI.
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Currently just reports the running app's version - this is deliberately the
# first small step of a CLI meant to grow over time (see docs/DESIGN-SPEC.md).
# Planned next: --get-settings / --set-settings, bridging into the app's own
# Settings via the same mechanism ExecReceiver already uses (Этап 6) - not
# implemented yet, this file is just the entry point those will hang off of.

VERSION_FILE=/data/local/tmp/Sshd4a/etc/app-version

cmd_version() {
    if [ -e "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown (no $VERSION_FILE - re-run provisioning: save Settings or restart the service)"
    fi
}

case "$1" in
    -v|--version|version)
        cmd_version
        ;;
    *)
        echo "Sshd4a extented CLI"
        printf 'Version: '
        cmd_version
        echo "Usage: sshd4a [-v|--version]"
        echo "More commands (app settings management, etc.) planned for later."
        ;;
esac
