#!/system/bin/sh
# Sshd4a extented - app control CLI.
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Commands: help, version, env, start, stop, status. Planned: --get-settings / --set-settings
# (needs a settings bridge into the app, not implemented yet).

BASE=/data/local/tmp/Sshd4a
VERSION_FILE=$BASE/etc/app-version
PKG=com.roshkond.sshd4a.extended
ACTIVITY=$PKG/com.hardbacknutter.sshd.QuickStartActivity

cmd_version() {
    if [ -e "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown (no $VERSION_FILE - re-run provisioning: save Settings or restart the service)"
    fi
}

# start/stop need the app's "Allow starting the service by an external Intent" option.
cmd_control() {
    am start -n "$ACTIVITY" -a "com.hardbacknutter.sshd.fg.$1" >/dev/null 2>&1 \
        || { echo "am start failed (is 'am' available in this shell?)"; return 1; }
    echo "Request sent: $1  (outcome: logcat -d -s ExternalControl)"
}

cmd_status() {
    port=
    [ -r "$BASE/etc/sshd-port" ] && port=$(cat "$BASE/etc/sshd-port")
    if [ -z "$port" ]; then
        echo "unknown: no $BASE/etc/sshd-port (save Settings or restart the service once)"
        return 1
    fi
    if [ ! -r /proc/net/tcp ]; then
        echo "unknown: /proc/net/tcp is not readable from this shell"
        return 1
    fi
    hex=$(printf '%04X' "$port")
    if grep -qiE "^ *[0-9]+: [0-9A-F]+:$hex [0-9A-F]+:[0-9A-F]+ 0A" /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
        echo "running: listening on port $port"
    else
        echo "not running: nothing is listening on port $port"
        return 3
    fi
}

cmd_env() {
    case "$1" in
        --file) echo "$BASE/etc/env" ;;
        *)
            # eval-able output, e.g.:  eval "$(sshd4a env)"
            echo "SSHD4A_BASE='$BASE'; export SSHD4A_BASE"
            echo "case \":\$PATH:\" in *':$BASE/bin:'*) ;; *) PATH=\"\$PATH:$BASE/bin\"; export PATH ;; esac"
            ;;
    esac
}

cmd_help() {
    printf 'Sshd4a extented  '
    cmd_version
    if [ -r "$BASE/etc/help.txt" ]; then
        cat "$BASE/etc/help.txt"
    else
        echo "(help text missing - re-run provisioning: save Settings or restart the service)"
    fi
}

case "$1" in
    -v|--version|version|ver)
        cmd_version
        ;;
    env)
        shift
        cmd_env "$@"
        ;;
    start) cmd_control START ;;
    stop)  cmd_control STOP ;;
    status) cmd_status ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "Sshd4a extented CLI"
        printf 'Version: '
        cmd_version
        echo "Usage: sshd4a [help|-v|--version|start|stop|status|env [--file]]"
        echo "Run 'help' for the full reference."
        ;;
esac
