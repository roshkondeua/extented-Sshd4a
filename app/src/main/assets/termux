#!/system/bin/sh
# Sshd4a extented - enter the Termux environment (commands: termux, tmx).
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Works from any role (user/shell/root) as long as the system `su` is usable:
# it starts a bare `su <termux uid> sh` whose $ENV (etc/rc-termux) sets up
# Termux's HOME/PREFIX/PATH and execs Termux's own login.
# Non-root operation (via Termux's RUN_COMMAND intent) is NOT implemented yet.

BASE=/data/local/tmp/Sshd4a
INFO=$BASE/etc/termux-info
TERMUX_INSTALLED=0
[ -r "$INFO" ] && . "$INFO"

if [ "$TERMUX_INSTALLED" != 1 ]; then
    echo "Termux is not installed (as of the last Sshd4a service start)."
    echo "Install it from F-Droid:  https://f-droid.org/packages/com.termux/"
    echo "or from GitHub releases:  https://github.com/termux/termux-app/releases"
    echo "Then restart the Sshd4a service (or save its settings) so this command notices it."
    exit 1
fi

if [ "$TERMUX_SOURCE" = "com.android.vending" ]; then
    echo "Note: this Termux was installed from Google Play. It is a separate build with a"
    echo "different signing key and is not supported by Termux's plugin/external-app features."
    echo "For full support install Termux from F-Droid or GitHub (uninstall this one first;"
    echo "back up its data, since the signatures differ)."
fi

if ! command -v su >/dev/null 2>&1; then
    echo "No usable 'su' found: entering Termux needs root for now."
    echo "Non-root access (Termux RUN_COMMAND; needs allow-external-apps=true in Termux and"
    echo "the com.termux.permission.RUN_COMMAND permission) is planned but not implemented yet."
    exit 1
fi

echo "Entering Termux ($TERMUX_VERSION, uid $TERMUX_UID, source: $TERMUX_SOURCE) ..."
SSHD4A_SHELL_UPGRADED=1 ENV="$BASE/etc/rc-termux" exec su "$TERMUX_UID" sh
