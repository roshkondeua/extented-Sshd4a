#!/system/bin/sh
# Sshd4a extented - minimal package manager for /data/local/tmp/Sshd4a/bin
# Auto-generated by RootProvisioner.java - do not edit, will be overwritten.
#
# Index format (one line per name+arch): name|arch|version|url|sha256|install_name
# Comment lines start with '#' and are ignored.
#
# Usage:
#   pkg update              refresh cached index(es) from all enabled repos
#   pkg list                 list packages available for this device's arch
#   pkg installed             list packages currently installed
#   pkg install <name>       download + verify + install a package
#   pkg remove <name>        remove an installed package
#   pkg repo list             list configured repo URLs
#   pkg repo add <url>       add a repo (index file URL)
#   pkg repo remove <url>    remove a repo

BASE=/data/local/tmp/Sshd4a
BIN=$BASE/bin
ETC=$BASE/etc
REPOS_FILE=$ETC/pkg-repos.list
CACHE_DIR=$ETC/pkg-cache
ARCH=$(getprop ro.product.cpu.abi)

mkdir -p "$CACHE_DIR" 2>/dev/null

download() {
    # $1 = url, $2 = output path
    # busybox wget preferred over curl: some curl builds link against c-ares,
    # which expects a traditional /etc/resolv.conf - Android doesn't have one
    # (DNS goes through netd instead), so such curl builds fail to resolve
    # hostnames even though ping/busybox wget (using Android's own resolver)
    # work fine. Confirmed on-device: "curl: (6) Could not resolve ... Could
    # not contact DNS servers" while ping/wget of the same host worked.
    if command -v busybox >/dev/null 2>&1; then
        busybox wget -q -O "$2" "$1"
    elif command -v curl >/dev/null 2>&1; then
        curl -fsSL "$1" -o "$2"
    else
        echo "No downloader available (need busybox or curl)"
        return 1
    fi
}

cache_file_for_repo() {
    # deterministic short name for a repo URL's cache file
    echo "$CACHE_DIR/$(echo "$1" | busybox md5sum | cut -c1-12).list"
}

cmd_update() {
    if [ ! -s "$REPOS_FILE" ]; then
        echo "No repos configured (see: pkg repo list)"
        return 1
    fi
    while IFS= read -r repo_url; do
        [ -z "$repo_url" ] && continue
        case "$repo_url" in \#*) continue ;; esac
        cf=$(cache_file_for_repo "$repo_url")
        echo "Updating: $repo_url"
        if download "$repo_url" "$cf.tmp"; then
            mv "$cf.tmp" "$cf"
        else
            echo "  FAILED to fetch $repo_url"
            rm -f "$cf.tmp"
        fi
    done < "$REPOS_FILE"
}

all_cache_lines() {
    for cf in "$CACHE_DIR"/*.list; do
        [ -e "$cf" ] || continue
        grep -v '^#' "$cf" | grep -v '^[[:space:]]*$'
    done
}

cmd_list() {
    all_cache_lines | awk -F'|' -v arch="$ARCH" \
        '$2==arch {printf "%-14s %-10s (%s)\n", $1, $3, $6}'
}

cmd_installed() {
    ls -1 "$BIN" 2>/dev/null
}

find_pkg_line() {
    # $1 = package name -> prints matching index line (name|arch|version|url|sha256|install_name), or nothing
    all_cache_lines | awk -F'|' -v arch="$ARCH" -v name="$1" '$1==name && $2==arch {print; exit}'
}

cmd_install() {
    name="$1"
    if [ -z "$name" ]; then
        echo "Usage: pkg install <name>"
        return 1
    fi
    line=$(find_pkg_line "$name")
    if [ -z "$line" ]; then
        echo "Package '$name' not found for arch $ARCH (try: pkg update)"
        return 1
    fi
    url=$(echo "$line" | awk -F'|' '{print $4}')
    sha=$(echo "$line" | awk -F'|' '{print $5}')
    install_name=$(echo "$line" | awk -F'|' '{print $6}')

    tmp="$BIN/.$install_name.download"
    echo "Downloading $name -> $BIN/$install_name"
    if ! download "$url" "$tmp"; then
        echo "Download failed"
        rm -f "$tmp"
        return 1
    fi

    got_sha=$(busybox sha256sum "$tmp" | awk '{print $1}')
    if [ "$got_sha" != "$sha" ]; then
        echo "sha256 MISMATCH - expected $sha, got $got_sha - aborting"
        rm -f "$tmp"
        return 1
    fi

    chmod 755 "$tmp"
    mv "$tmp" "$BIN/$install_name"
    echo "Installed: $BIN/$install_name"
}

cmd_remove() {
    name="$1"
    if [ -z "$name" ]; then
        echo "Usage: pkg remove <name>"
        return 1
    fi
    if [ -e "$BIN/$name" ]; then
        rm -f "$BIN/$name"
        echo "Removed: $BIN/$name"
    else
        echo "Not installed: $name"
        return 1
    fi
}

cmd_repo() {
    case "$1" in
        list)
            cat "$REPOS_FILE" 2>/dev/null
            ;;
        add)
            [ -z "$2" ] && { echo "Usage: pkg repo add <url>"; return 1; }
            grep -qxF "$2" "$REPOS_FILE" 2>/dev/null || echo "$2" >> "$REPOS_FILE"
            echo "Added: $2 (run 'pkg update' to fetch it)"
            ;;
        remove)
            [ -z "$2" ] && { echo "Usage: pkg repo remove <url>"; return 1; }
            grep -vxF "$2" "$REPOS_FILE" > "$REPOS_FILE.tmp" 2>/dev/null
            mv "$REPOS_FILE.tmp" "$REPOS_FILE"
            echo "Removed: $2"
            ;;
        *)
            echo "Usage: pkg repo [list|add <url>|remove <url>]"
            return 1
            ;;
    esac
}

case "$1" in
    update)    cmd_update ;;
    list)      cmd_list ;;
    installed) cmd_installed ;;
    install)   shift; cmd_install "$1" ;;
    remove)    shift; cmd_remove "$1" ;;
    repo)      shift; cmd_repo "$@" ;;
    *)
        echo "Sshd4a extented package manager"
        echo "Usage: pkg [update|list|installed|install <name>|remove <name>|repo ...]"
        ;;
esac
