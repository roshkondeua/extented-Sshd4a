# ############################################################################
#   wsl --install Debian
#   wsl -d Debian

# ############################################################################
# Debian environment prerequisites
# ############################################################################

# Bring Debian up-to-date if needed.
sudo apt update && sudo apt upgrade -y

# Install Java 21
sudo apt install -y openjdk-21-jdk-headless

# Install build-essential: glibc headers + tools for the NDK,
# unzip/wget for the SDK tools and gawk/awk for rsync building
sudo apt install -y build-essential wget unzip git gawk

# ############################################################################
# Fedora environment prerequisites
# ############################################################################

sudo dnf upgrade --refresh -y

# Fedora 44 only provides java 25.
sudo dnf install -y java-25-openjdk-devel

sudo dnf install -y @development-tools wget unzip git gawk

# ############################################################################
# Android SDK installation
# ############################################################################

# choose/create a location
export ANDROID_HOME=$HOME/android-sdk
mkdir -p $ANDROID_HOME/cmdline-tools
cd $ANDROID_HOME/cmdline-tools

# Check the url and get the latest version. Below version was current on 2026-05-14.
# When updating, make sure to re-link "latest"
# https://developer.android.com/studio#command-line-tools-only
wget https://dl.google.com/android/repository/commandlinetools-linux-14742923_latest.zip
unzip commandlinetools-linux-14742923_latest.zip
rm commandlinetools-linux-14742923_latest.zip
mv cmdline-tools 20.0
ln -s 20.0 latest
cd ~

# Add to the path. You may want to add these to your permanent environment.
export PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH

# Accept the licence
yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses
